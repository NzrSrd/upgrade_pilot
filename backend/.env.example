# --- Model provider -------------------------------------------------------
# Two supported providers, both speaking the OpenAI API. Pick ONE block.
#
# The key is read from OPENROUTER_API_KEY, then OPENAI_API_KEY, then
# UP_LLM_API_KEY, in that order — a machine carrying more than one resolves
# by that fixed order rather than by which happened to be exported.
#
# Model ids are provider-scoped and the two providers disagree, so the id
# must match the block you chose.

# OpenRouter (what this project is developed against):
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
UP_CHAT_MODEL=openai/gpt-4.1-mini
UP_EMBEDDING_MODEL=openai/text-embedding-3-small

# OpenAI direct — leave the base URL UNSET, which selects the client default:
# OPENAI_API_KEY=sk-replace-me
# UP_CHAT_MODEL=gpt-4.1-mini
# UP_EMBEDDING_MODEL=text-embedding-3-small

# --- Local stores ---------------------------------------------------------
UP_CHROMA_DIR=./.chroma
UP_CHECKPOINT_DB=./checkpoints.db
UP_WORKSPACE_DIR=./.workspaces

# --- Repository access guards ---------------------------------------------
UP_ALLOWED_LOCAL_ROOTS=/Users/nzrsrd/Code
UP_ALLOWED_URL_SCHEMES=https,git
UP_MAX_REPO_FILES=5000
UP_MAX_REPO_BYTES=52428800
UP_CLONE_DEPTH=100

# --- Graph and run limits -------------------------------------------------
UP_MAX_RAG_ITERATIONS=3
UP_MAX_CONCURRENT_RUNS=4

# --- API ------------------------------------------------------------------
UP_CORS_ORIGINS=http://localhost:5173
